# ==========================================
# UpPitch Environment Configuration Template
# Copy this file to .env.local for local development
# ==========================================

# 1. Google Gemini AI API Configuration
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini Model ID (check Google's current model list for available models)
GEMINI_MODEL=your_primary_gemini_model_here

# Optional Fallback Gemini Model ID (check Google's current model list for available models)
GEMINI_FALLBACK_MODEL=your_fallback_gemini_model_here

# 2. Rate Limiting Configuration
# Server key generation requests per hour per IP (default: 10)
RATE_LIMIT_SERVER_PER_HOUR=10

# BYOK (Bring Your Own Key) requests per hour per IP (default: 30)
RATE_LIMIT_BYOK_PER_HOUR=30

# 3. Upstash Redis (Optional - for distributed rate limiting across serverless instances)
# If omitted, UpPitch automatically falls back to in-memory rate limiting.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# 4. Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://uppitch.vercel.app

# Optional Contact & Support email (e.g. support@uppitch.dev)
# If configured, activates the "Contact Support" link in the footer.
NEXT_PUBLIC_FEEDBACK_EMAIL=support@uppitch.dev

# Optional Twitter/X handle for social metadata and footer link (e.g. @UpPitchAI)
# NEXT_PUBLIC_TWITTER_HANDLE=@UpPitchAI

