# ==========================================
# UpPitch Environment Configuration Template
# Copy this file to .env.local for local development
# ==========================================

# 1. Google Gemini AI API Configuration
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini Model ID (e.g., gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional Fallback Gemini Model ID (used if primary model encounters 429/5xx)
GEMINI_FALLBACK_MODEL=gemini-1.5-flash-8b

# 2. Upstash Redis (Optional - for distributed rate limiting across serverless instances)
# If omitted, UpPitch automatically falls back to in-memory rate limiting.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# 3. Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://uppitch.vercel.app
